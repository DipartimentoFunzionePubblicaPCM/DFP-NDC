    ns1:title "Distribuzione JSON_LD del vocabolario controllato dei settori scientifico-disciplinari per il dottorato (SSD)"@it,
        "Scientific-Disciplinary Sectors for Doctoral Programs (SSD) Controlled Vocabulary JSON_LD distribution"@en ;
    ns3:accessURL <https://github.com/DipartimentoFunzionePubblicaPCM/DFP-NDC/tree/main/assets/controlled-vocabularies/elenco_settori_scientifico_disciplinari_dottorato/latest> ;
