  <rdf:Description rdf:about="https://w3id.org/italia/public-administration-governance/data/public-sector-recruitment/distribution/PARECRUIT-RDF-TURTLE">
    <dcterms:description xml:lang="it">Questa è la distribuzione RDF/Turtle dell'ontologia del reclutamento nella Pubblica Amministrazione. La risorsa definisce le classi e le relazioni relative a categorie di reclutamento (es. bandi di concorso), procedure di selezione, candidature, fornendo la struttura concettuale necessaria per garantire l'interoperabilità dei dati tra i sistemi di gestione delle risorse umane e i portali di reclutamento.</dcterms:description>
    <dcterms:description xml:lang="en">This is the distribution in RDF/Turtle of the Recruitment in the Public Administration Ontology. The resource models the domain of personnel recruitment within Italian public administrations through the inPA portal (single recruitment portal - in Public Administration). The resource defines the classes and relationships related to recruitment categories (e.g., calls for applications), selection procedures, and applications, providing the conceptual structure necessary to ensure data interoperability between human resource management systems and recruitment portals.</dcterms:description>
    <dcat:downloadURL rdf:resource="https://raw.githubusercontent.com/DipartimentoFunzionePubblicaPCM/DFP-NDC/tree/main/assets/ontologies/public-sector-recruitment/latest/public-sector-recruitment.ttl"/>
    <rdf:type rdf:resource="http://www.w3.org/ns/dcat#Distribution"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://dati.gov.it/onto/dcatapit#Distribution"/>
    <rdf:type rdf:resource="https://w3id.org/italia/onto/ADMS/SemanticAssetDistribution"/>
    <dcterms:title xml:lang="en">RDF/Turtle distribution of the Recruitment in the Public Administration Ontology</dcterms:title>
    <dcterms:title xml:lang="it">Distribuzione RDF/Turtle dell'ontologia del reclutamento nella Pubblica Amministrazione</dcterms:title>
    <dcterms:format rdf:resource="http://publications.europa.eu/resource/authority/file-type/RDF_TURTLE"/>
    <dcat:accessURL rdf:resource="https://github.com/DipartimentoFunzionePubblicaPCM/DFP-NDC/tree/main/assets/ontologies/public-sector-recruitment/latest"/>
    <dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
  </rdf:Description>
