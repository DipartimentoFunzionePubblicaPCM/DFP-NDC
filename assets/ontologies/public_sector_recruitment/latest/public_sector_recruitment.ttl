<https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/TipoRuoloInCorso> a owl:Class ;
    rdfs:label "Tipo ruolo in corso"@it ;
    rdfs:comment "Classifica il ruolo ricoperto nell'ambito di un corso di formazione (docente, discente, …)"@it .

<https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/ValorizzazioneRegolaAmmissione> a owl:Class ;
    rdfs:label "Valorizzazione regola ammissione"@it ;
    rdfs:subClassOf <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/ValorizzazioneRequisito>,
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/haRegolaInValorizzazione> ;
            owl:someValuesFrom owl:Thing ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/haValorizzazioneRegolaDiAmmissione> ] ;
            owl:someValuesFrom owl:Thing ] ;
    owl:disjointWith <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/ValorizzazioneRequisitoDiPartecipazione> ;
    rdfs:comment "Valorizzazione di una regola di ammissione per una specifica candidatura."@it .

<https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/ValorizzazioneRequisito> a owl:Class ;
    rdfs:label "Valorizzazione requisito"@it ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf (
                    <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/ValorizzazioneRegolaAmmissione>
                    <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/ValorizzazioneRequisitoDiPartecipazione> ) ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/valoreDelRequisitoPerCandidatura> ;
            owl:someValuesFrom rdfs:Literal ] ;
    rdfs:comment "Generalizzazione della valorizzazione dei requisiti, generici e specifici, attribuiti alle candidature."@it .

<https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/ValorizzazioneRequisitoDiPartecipazione> a owl:Class ;
    rdfs:label "Valorizzazione requisito di partecipazione"@it ;
    rdfs:subClassOf <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/ValorizzazioneRequisito>,
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/haRequisitoInValorizzazione> ;
            owl:someValuesFrom owl:Thing ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/haValorizzazioneRequisitoDiPartecipazione> ] ;
            owl:someValuesFrom owl:Thing ] ;
    rdfs:comment "Valorizzazione di un requisito di partecipazione per una specifica candidatura."@it .

