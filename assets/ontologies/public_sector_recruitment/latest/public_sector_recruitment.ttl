            owl:someValuesFrom [ a owl:Class ;
                    owl:oneOf (
                            <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/procedureStraordinarie> ) ] ] ;
    rdfs:comment "Sottoclasse di Pubblicazione di reclutamento PA che raggruppa le pubblicazioni con categoria di reclutamento valorizzata a \"procedure straordinarie\"."@it .

<https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/ProprietàDellaCandidatura> a owl:Class ;
