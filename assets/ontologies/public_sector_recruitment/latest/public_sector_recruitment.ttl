<https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/TipoDiQualifica> a owl:Class ;
    rdfs:label "Tipo di qualifica"@it ;
    rdfs:comment "Classifica le tipologie di qualifiche accademiche."@it .

<https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/TipoOrarioDiLavoro> a owl:Class ;
    rdfs:label "Tipo orario di lavoro"@it ;
