<https://w3id.org/italia/public-administration-governance/data/public_sector_recruitment/distribution/PARECRUIT-N-TRIPLES> a adms:SemanticAssetDistribution,
        dcat:Distribution,
        dcatapit:Distribution,
        owl:NamedIndividual ;
    dcat:accessURL <https://github.com/DipartimentoFunzionePubblicaPCM/DFP-NDC/tree/main/assets/ontologies/public_sector_recruitment/latest> ;
    dcat:downloadURL <https://raw.githubusercontent.com/DipartimentoFunzionePubblicaPCM/DFP-NDC/tree/main/assets/ontologies/public_sector_recruitment/latest/public_sector_recruitment.n3> ;
    dct:description "Questa è la distribuzione N-TRIPLES dell'ontologia del reclutamento nella Pubblica Amministrazione. La risorsa definisce le classi e le relazioni relative a categorie di reclutamento (es. bandi di concorso), procedure di selezione, candidature, fornendo la struttura concettuale necessaria per garantire l'interoperabilità dei dati tra i sistemi di gestione delle risorse umane e i portali di reclutamento."@it,
        "This is the distribution in N-TRIPLES of the Recruitment in the Public Administration Ontology. The resource models the domain of personnel recruitment within Italian public administrations through the inPA portal (single recruitment portal - in Public Administration). The resource defines the classes and relationships related to recruitment categories (e.g., calls for applications), selection procedures, and applications, providing the conceptual structure necessary to ensure data interoperability between human resource management systems and recruitment portals."@en ;
    dct:format <http://publications.europa.eu/resource/authority/file-type/RDF_N_TRIPLES> ;
    dct:license <http://creativecommons.org/licenses/by/4.0/> ;
    dct:title "Distribuzione N-TRIPLES dell'ontologia del reclutamento nella Pubblica Amministrazione"@it,
        "N-TRIPLES distribution of the Recruitment in the Public Administration Ontology"@en .

