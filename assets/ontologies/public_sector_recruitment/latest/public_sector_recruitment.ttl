        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/haPagamentoTassaIscrizione> ] ;
            owl:someValuesFrom owl:Thing ] ;
    rdfs:comment "Importo richiesto al candidato per iscriversi al concorso pubblico."@it .

<https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/TipoDiAttività> a owl:Class ;
    rdfs:label "Tipo di attività"@it ;
    rdfs:comment "Tipologia di lavoro o incarico per cui viene indetta la procedura selettiva."@it .

<https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/TipoDiAutore> a owl:Class ;
    rdfs:label "Tipo di autore"@it ;
    rdfs:comment "Classifica un autore in base al suo coinvolgimento nell'ambito di una pubblicazione."@it .

<https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/TipoDiAzienda> a owl:Class ;
    rdfs:label "Tipo di azienda"@it ;
    rdfs:comment "Classifica le tipologie delle aziende."@it .

<https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/TipoDiContratto> a owl:Class ;
    rdfs:label "Tipo di contratto"@it ;
    rdfs:comment "Classifica le tipologie di contratto di lavoro."@it .

<https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/TipoDiCorso> a owl:Class ;
    rdfs:label "Tipo di corso"@it ;
    rdfs:comment "Classifica le tipologie di corso di formazione anche relativamente al titolo conseguito al termine della frequenza dello stesso."@it .

<https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/TipoDiEsame> a owl:Class ;
    rdfs:label "Tipo di esame"@it ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/haTipoDiEsame> ] ;
            owl:someValuesFrom owl:Thing ] ;
    rdfs:comment "Classifica le diverse tipologie di esame."@it .

<https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/TipoDiIstitutoDiFormazione> a owl:Class ;
    rdfs:label "Tipo di istituto di formazione"@it ;
    rdfs:comment "Classifica le tipologie di istituti di formazione."@it .

<https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/TipoDiMezzoDiTrasporto> a owl:Class ;
    rdfs:label "Tipo di mezzo di trasporto"@it ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/èCategoriaDiMezzoDiTrasporto> ] ;
            owl:someValuesFrom owl:Thing ] ;
    rdfs:comment "Classifica le diverse tipologie di mezzo di trasporto che una persona può condurre."@it .

<https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/TipoDiPubblicazione> a owl:Class ;
    rdfs:label "Tipo di pubblicazione"@it ;
