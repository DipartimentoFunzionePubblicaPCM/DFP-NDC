L0:identifier a owl:DatatypeProperty .

L0:name a owl:DatatypeProperty .

### Classes

CLV:AdminUnitComponent a owl:Class .

COV:Organization a owl:Class .

COV:PublicOrganization a owl:Class .

CPV:Alive a owl:Class .

<https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/Allegato> a owl:Class ;
    rdfs:label "Allegato"@it ;
    rdfs:comment "Documento integrativo di una lettera o una pratica per fornire informazioni aggiuntive o completarne il contenuto."@it .

<https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/AllegatoCandidatura> a owl:Class ;
    rdfs:label "Allegato candidatura"@it ;
    rdfs:subClassOf <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/Allegato> ;
    rdfs:comment "Documento che accompagna la candidatura di un partecipante contenente informazioni e documenti richiesti per la procedura selettiva."@it .

<https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/AllegatoPubblicazioneReclutamento> a owl:Class ;
    rdfs:label "Allegato pubblicazione reclutamento"@it ;
    rdfs:subClassOf <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/Allegato> ;
    rdfs:comment "Documento correlato alla pubblicazione di procedure selettive di reclutamento che fornisce dettagli aggiuntivi riuardanti il concorso."@it .

<https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/AreaGeografica> a owl:Class ;
    rdfs:label "Area geografica"@it ;
    rdfs:comment "Zona territoriale di assegnazione a cui saranno destinati i vincitori della procedura selettiva."@it .

<https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/AttivitàDiInsegnamento> a owl:Class ;
    rdfs:label "Attività di insegnamento"@it ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/haEsperienzaDiInsegnamento> ;
            owl:someValuesFrom owl:Thing ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/haIstitutodiInsegnamento> ;
            owl:someValuesFrom owl:Thing ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/numeroAnniInsegnamento> ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/numeroOreInsegnamento> ;
            owl:someValuesFrom rdfs:Literal ] ;
    rdfs:comment "Incarico formativo svolto da un utente che può essere considerato nel processo di selezione."@it .

<https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/AttoDiEquiparazioneQualificaEstera> a owl:Class ;
    rdfs:label "Atto di equiparazione qualifica estera"@it ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf (
                    <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/AttoDiEquipollenzaQualifica>
                    <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/AttoDiEquivalenzaQualifica> ) ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/haAutoritàDiEmissione> ;
            owl:someValuesFrom owl:Thing ] ;
    rdfs:comment "Atto di riconoscimento di una qualifica accademica o professionale conseguita presso una stato estero necessaria per poter svolgere la relativa attività professionale in Italia o partecipare a concorsi indetti dalla PA."@it .

<https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/AttoDiEquipollenzaQualifica> a owl:Class ;
    rdfs:label "Atto di equipollenza qualifica"@it ;
    owl:disjointWith <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/AttoDiEquivalenzaQualifica> ;
    rdfs:comment "Sottoclasse di Atto di equiparazione qualifica accademica riferita al riconoscimento accademico del titolo posseduto ovvero all'equiparazione del suo valore legale."@it .

<https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/AttoDiEquivalenzaQualifica> a owl:Class ;
    rdfs:label "Atto di equivalenza qualifica"@it ;
    rdfs:comment "Sottoclasse di Atto di equiparazione qualifica accademica riferita al riconoscimento della validità del titolo posseduto al fine della partecipazione a corsi di studio o concorsi pubblici."@it .

<https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/AvvisoDiMobilità> a owl:Class ;
    rdfs:label "Avviso di mobilità"@it ;
    rdfs:subClassOf <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/PubblicazioneDiReclutamentoPA>,
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/haCategoriaDiReclutamento> ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:oneOf (
                            <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/avvisoDiMobilità> ) ] ] ;
    rdfs:comment "Sottoclasse di \"Pubblicazione di reclutamento PA\" che raggruppa le pubblicazioni con categoria di reclutamento caratterizzate dal valore \"avviso di mobilità\", relativa a procedure selettive riservate a soggetti già appartenenti alla Pubblica Amministrazione."@it .

<https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/AvvisoOIV> a owl:Class ;
    rdfs:label "Avviso OIV"@it ;
    rdfs:subClassOf <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/PubblicazioneDiReclutamentoPA>,
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/haCategoriaDiReclutamento> ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:oneOf (
                            <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/avvisoOIV> ) ] ] ;
    rdfs:comment "Sottoclasse di \"Pubblicazione di reclutamento\" PA che raggruppa le pubblicazioni con categoria di reclutamento valorizzata a \"avviso OIV\" (Organismi indipendenti di valutazione)."@it .

<https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/BandoApprendistato> a owl:Class ;
    rdfs:label "Bando apprendistato"@it ;
    rdfs:subClassOf <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/PubblicazioneDiReclutamentoPA>,
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/haCategoriaDiReclutamento> ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:oneOf (
                            <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/bandoApprendistato> ) ] ] ;
    rdfs:comment "Sottoclasse di \"Pubblicazione di reclutamento PA\" che raggruppa le pubblicazioni con categoria di reclutamento caratterizzate dal valore \"bando apprendistato\", relativa a procedure di selezione per l'inserimento di personale con contratto di lavoro di apprendistato all'interno della Pubblica Amministrazione."@it .

<https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/CandidaturaProceduraReclutamento> a owl:Class ;
    rdfs:label "Candidatura procedura reclutamento"@it ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/haCandidato> ;
            owl:someValuesFrom owl:Thing ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/haProceduraReclutamentoDiCandidatura> ;
            owl:someValuesFrom owl:Thing ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/haStatoDiCandidatura> ;
            owl:someValuesFrom owl:Thing ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/identificativoCandidatura> ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/identificativoDomandaDiCandidatura> ;
            owl:someValuesFrom rdfs:Literal ] ;
    rdfs:comment "Domanda di partecipazione (application form) a una procedura di reclutamento."@it .

<https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/CategoriaDellaCompetenza> a owl:Class ;
    rdfs:label "Categoria della competenza"@it ;
    rdfs:comment "Classifica le categorie in cui si articolano le competenze."@it .

<https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/CategoriaDiReclutamento> a owl:Class ;
    rdfs:label "Categoria di reclutamento"@it ;
    rdfs:comment "Classificazione dei concorsi e bandi in base a specifici ambiti, modalità o settori."@it .

<https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/CategoriaPatenteDiGuida> a owl:Class ;
    rdfs:label "Categoria patente di guida"@it ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/èCategoriaDiMezzoDiTrasporto> ;
            owl:someValuesFrom owl:Thing ] ;
    rdfs:comment "Classifica le categorie di patente di guida."@it .

<https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/CompetenzaLinguistica> a owl:Class ;
    rdfs:label "Competenza linguistica"@it ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/avvisoMadreLingua> ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/haLinguaDiCompetenza> ;
            owl:someValuesFrom owl:Thing ] ;
    rdfs:comment "Lingua straniera su cui un candidato ha compentenza."@it .

<https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/Concorso> a owl:Class ;
    rdfs:label "Concorso"@it ;
    rdfs:subClassOf <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/PubblicazioneDiReclutamentoPA>,
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/haCategoriaDiReclutamento> ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:oneOf (
                            <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/concorso> ) ] ] ;
    rdfs:comment "Sottoclasse di \"Pubblicazione di reclutamento PA\" che raggruppa le pubblicazioni con categoria di reclutamento caratterizzate dal valore \"concorso\", relativa a bandi pubblici per l'assunzione di personale nella Pubblica Amministrazione."@it .

<https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/ConcorsoDFP-FormezPA> a owl:Class ;
    rdfs:label "Concorso DFP - Formez PA"@it ;
    rdfs:subClassOf <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/PubblicazioneDiReclutamentoPA>,
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/haCategoriaDiReclutamento> ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:oneOf (
                            <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/concorsoDFP-FormezPA> ) ] ] ;
    rdfs:comment "Sottoclasse di \"Pubblicazione di reclutamento PA\" che raggruppa le pubblicazioni con categoria di reclutamento caratterizzate dal valore \"Concorso DFP-Formez PA\", relativa a bandi e avvisi gestiti con il supporto tecnico-operativo di Formez PA per conto delle amministrazioni centrali o locali ovvero banditi dalla Commissione interministeriale RIPAM."@it .

<https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/ConsuntivoDiProcedura> a owl:Class ;
    rdfs:label "Consuntivo di procedura"@it ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/haConsuntivoDiProcedura> ] ;
            owl:someValuesFrom owl:Thing ] ;
    rdfs:comment "Totalizzazione delle dimensioni di misura della procedura di reclutamento: numero iscritti, pagamenti ricevuti, etc."@it .

<https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/CurriculumVitae> a owl:Class ;
    rdfs:label "Curriculum vitae"@it ;
    rdfs:comment "Classifica le diverse istanze di curriculum vitae ovvero gli aggregati di informazioni concernenti i percorsi formativi, le esperienze professionali, le attitudini e le competenze possedute da un partecipante e presentate nell'ambito di una procedura di reclutamento."@it .

<https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/DescrittoreCompetenza> a owl:Class ;
    rdfs:label "Descrittore competenza"@it ;
    rdfs:subClassOf <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/DescrittoreGenerico>,
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/haCategoriaDellaCompetenza> ;
            owl:someValuesFrom owl:Thing ] ;
    rdfs:comment "Sottoclasse di Descrittore generico dedicata a descrivere una competenza (skill)."@it .

<https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/DescrittoreGenerico> a owl:Class ;
    rdfs:label "Descrittore generico"@it ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty L0:identifier ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty L0:name ;
            owl:someValuesFrom rdfs:Literal ] ;
    rdfs:comment "Istanzia la descrizione di un qualsiasi oggetto del mondo. È tipicamente costituito da un codice, un nome e una descrizione."@it .

<https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/DescrittoreLingua> a owl:Class ;
    rdfs:label "Descrittore lingua"@it ;
    rdfs:subClassOf <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/DescrittoreGenerico>,
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/nomeLinguaInItaliano> ;
            owl:someValuesFrom rdfs:Literal ] ;
    rdfs:comment "Sottoclasse di Descrittore generico dedicata alla descrizione di una lingua."@it .

<https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/DescrittoreRuolo> a owl:Class ;
    rdfs:label "Descrittore ruolo"@it ;
    rdfs:subClassOf <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/DescrittoreGenerico> ;
    rdfs:comment "Definizione delle responsabilità e delle competenze proprie di un determinato ruolo professionale ricoperto."@it .

<https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/ElementoStatistico> a owl:Class ;
    rdfs:label "Elemento statistico"@it ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/valoreElementoStatisticoTestuale> ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty L0:name ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/haElementoStatistico> ] ;
            owl:someValuesFrom owl:Thing ] ;
    rdfs:comment "Dato quantitativo riferito a una determinata dimensione utilizzato nell'ambito di una serie statistica per analizzare e valutare i risultati delle procedure di reclutamento."@it .

<https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/EsameDiSelezione> a owl:Class ;
    rdfs:label "Esame di selezione"@it ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/haTipoDiEsame> ;
            owl:someValuesFrom owl:Thing ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/indicatoreDiEsame> ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/haEsameDiSelezione> ] ;
            owl:someValuesFrom owl:Thing ] ;
    owl:disjointWith <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/SessioneDiEsame> ;
    rdfs:comment "Prova che i candidati devono superare per essere selezionati nell'ambito di una procedura di reclutamento."@it .

<https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/EsitoPartecipazioneSessioneDiEsame> a owl:Class ;
    rdfs:label "Esito partecipazione sessione di esame"@it ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/haEsitoPartecipazioneSessioneDiEsame> ] ;
            owl:someValuesFrom owl:Thing ] ;
    rdfs:comment "Risultato ottenuto da un candidato nella partecipazione a una prova selettiva."@it .

<https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/EsperienzaDiFormazione> a owl:Class ;
    rdfs:label "Esperienza di formazione"@it ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/avvisoEsameFinale> ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/haEventoDiFormazione> ;
            owl:someValuesFrom owl:Thing ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/haIstitutoDiFormazione> ;
            owl:someValuesFrom owl:Thing ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/haTipoRuoloInCorso> ;
            owl:someValuesFrom owl:Thing ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/numeroOreFormazione> ;
            owl:someValuesFrom rdfs:Literal ] ;
    rdfs:comment "Esperienza formativa a cui un canditato ha preso parte."@it .

<https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/EsperienzaGenerica> a owl:Class ;
    rdfs:label "Esperienza generica"@it ;
    rdfs:subClassOf TI:TimeIndexedEvent ;
    rdfs:comment "Esperienza professionale non specifica ma che può rilevare per il profilo del partecipante."@it .

<https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/EsperienzaLavorativa> a owl:Class ;
    rdfs:label "Esperienza lavorativa"@it ;
    rdfs:subClassOf TI:TimeIndexedEvent,
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/haDatoreDiLavoro> ;
            owl:someValuesFrom owl:Thing ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/haTipoDiContratto> ;
            owl:someValuesFrom owl:Thing ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/haTipoOrarioDiLavoro> ;
            owl:someValuesFrom owl:Thing ],
        [ a owl:Restriction ;
            owl:onProperty L0:identifier ;
            owl:someValuesFrom rdfs:Literal ] ;
    rdfs:comment "Esperienza professionale di un partecipante che può essere considerata significativa nel processo di selezione."@it .

<https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/EsperienzaLavorativaPA> a owl:Class ;
    rdfs:label "Esperienza lavorativa PA"@it ;
    rdfs:subClassOf <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/EsperienzaLavorativa> ;
    owl:disjointWith <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/EsperienzaLavorativaPrivata> ;
    rdfs:comment "Esperienza professionale maturata all'interno della Pubblica Amministrazione."@it .

<https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/EsperienzaLavorativaPrivata> a owl:Class ;
    rdfs:label "Esperienza lavorativa privata"@it ;
    rdfs:subClassOf <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/EsperienzaLavorativa> ;
    rdfs:comment "Esperienza professionale maturata in aziende private."@it .

<https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/EventoDiFormazione> a owl:Class ;
    rdfs:label "Evento di formazione"@it ;
    rdfs:subClassOf <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/EsperienzaGenerica>,
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/haEventoDiFormazione> ] ;
            owl:someValuesFrom owl:Thing ] ;
    rdfs:comment "Evento formativo a cui un partecipante ha preso parte e che può contribuire alla valutazione nel processo di selezione."@it .

<https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/GradoDiCompetenzaLingua> a owl:Class ;
    rdfs:label "Grado di competenza lingua"@it ;
    rdfs:comment "Classifica le competenza nell'utilizzo di una lingua nell'ambito dei diversi usi della stessa (comprensione, parlato, scritto, …) secondo lo standard internazionale."@it .

<https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/GraduatoriaDiReclutamento> a owl:Class ;
    rdfs:label "Graduatoria di reclutamento"@it ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/dataCreazioneGraduatoria> ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/titoloGraduatoria> ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/èGraduatoriaDiProceduraDiReclutamento> ;
            owl:someValuesFrom owl:Thing ] ;
    rdfs:comment "Istanza della classifica dei candidati in base ai risultati ottenuti nel processo di selezione."@it .

<https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/InformazioneAggiuntiva> a owl:Class ;
    rdfs:label "Informazione aggiuntiva"@it ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/haProprietàDellaCandidatura> ;
            owl:someValuesFrom owl:Thing ] ;
    owl:disjointWith <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/PreferenzaAggiuntiva> ;
    rdfs:comment "Dettagli supplementari forniti dal candidato che possono rilevare nel punteggio attribuito alla candidatura."@it .

<https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/IntervalloSalariale> a owl:Class ;
    rdfs:label "Intervallo salariale"@it ;
    rdfs:comment "Intervallo economico dello stipendio previsto per la posizione oggetto del reclutamento."@it .

<https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/IstitutoDiFormazione> a owl:Class ;
    rdfs:label "Istituto di formazione"@it ;
    rdfs:subClassOf COV:Organization,
        [ a owl:Restriction ;
            owl:onProperty CLV:hasAddress ;
            owl:someValuesFrom owl:Thing ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/haTipoDiIstitutoDiFormazione> ;
            owl:someValuesFrom owl:Thing ] ;
    rdfs:comment "Classifica gli istituti di formazione nell'ambito del rilascio di una qualifica accademica. È sottoclasse di COV:Organization."@it .

<https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/LivelloDiPubblicazione> a owl:Class ;
    rdfs:label "Livello di pubblicazione"@it ;
    rdfs:comment "Classifica la platea e il grado di diffusione della pubblicazione."@it .

<https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/ModalitàDiValutazione> a owl:Class ;
    rdfs:label "Modalità di valutazione"@it ;
    rdfs:comment "Classificazione dei criteri e metodi utilizzati per valutare i candidati durante il processo di selezione."@it .

<https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/PartecipanteSessioneEsame> a owl:Class ;
    rdfs:label "Partecipante sessione esame"@it ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/haEsitoPartecipazioneSessioneDiEsame> ;
            owl:someValuesFrom owl:Thing ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/haPartecipanteSessioneDiEsame> ] ;
            owl:someValuesFrom owl:Thing ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf RO:holdsRoleInTime ] ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty [ owl:inverseOf <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/haCandidato> ] ;
                    owl:someValuesFrom owl:Thing ] ] ;
    owl:disjointWith <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/PosizioneInGraduatoriaDiReclutamento> ;
    rdfs:comment "Ruolo assunto da un candidato al momento dell'effettiva partecipazione alla selezione per la procedura di reclutamento per cui ha presentato la candidatura."@it .

<https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/PatenteDiGuida> a owl:Class ;
    rdfs:label "Patente di guida"@it ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/haCategoriaPatenteDiGuida> ;
            owl:someValuesFrom owl:Thing ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/haPeriodoDiValiditàPatenteDiGuida> ;
            owl:someValuesFrom owl:Thing ],
        [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/haTipoMezzoDiTrasporto> ;
            owl:someValuesFrom owl:Thing ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/haPatenteDiGuida> ] ;
            owl:someValuesFrom owl:Thing ] ;
    rdfs:comment "Classifica le patenti di guida di mezzi di trasporto possedute da una persona."@it .

<https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/PeriodoDiValiditàPatenteDiGuida> a owl:Class ;
    rdfs:label "Periodo di validità patente di guida"@it ;
    rdfs:subClassOf L0:Sequence,
        TI:TimeInterval,
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/haPeriodoDiValiditàPatenteDiGuida> ] ;
            owl:someValuesFrom owl:Thing ] ;
    rdfs:comment "Classifica la sequenza dei periodi di validità di una patente di guida."@it .

<https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/PosizioneInGraduatoriaDiReclutamento> a owl:Class ;
    rdfs:label "Posizione in graduatoria di reclutamento"@it ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/èPosizioneInGraduatoria> ;
            owl:someValuesFrom owl:Thing ] ;
    rdfs:comment "Posizione di un candidato all'interno della graduatoria della procedura selettiva."@it .

<https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/PreferenzaAggiuntiva> a owl:Class ;
    rdfs:label "Preferenza aggiuntiva"@it ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/haProprietàDellaCandidatura> ;
            owl:someValuesFrom owl:Thing ] ;
    rdfs:comment "Opzione che permette a un candidato di esprimere ulteriori dichiarazioni, se richieste nella candidatura."@it .

<https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/PreferenzaAmbito> a owl:Class ;
    rdfs:label "Preferenza ambito"@it ;
    rdfs:subClassOf <https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/DescrittoreGenerico> ;
    rdfs:comment "Indicazione da parte di un candidato riguardo all'ambito professionale in cui desidera essere assegnato."@it .

<https://w3id.org/italia/public-administration-governance/onto/public-sector-recruitment/PreferenzaLuogoDiLavoro> a owl:Class ;
    rdfs:label "Preferenza luogo di lavoro"@it ;
    rdfs:subClassOf CLV:AdminUnitComponent,
